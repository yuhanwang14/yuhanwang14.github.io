---
// src/pages/blog/tags/[tag].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import EssayFrames from '../../../components/blog/EssayFrames.astro';
import { groupByBaseSlug, slugify, type PostGroup } from '../../../lib/blog';

type Group = PostGroup<CollectionEntry<'blog'>>;

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  const groups = groupByBaseSlug(all);

  // Aggregate by tag: tags come from the primary post's frontmatter.
  const tagMap = new Map<string, { displayName: string; groups: Group[] }>();
  for (const g of groups) {
    for (const tag of g.primary.data.tags) {
      const key = slugify(tag);
      const entry = tagMap.get(key);
      if (entry) {
        entry.groups.push(g);
      } else {
        tagMap.set(key, { displayName: tag, groups: [g] });
      }
    }
  }

  return Array.from(tagMap.entries()).map(([slug, { displayName, groups: gs }]) => ({
    params: { tag: slug },
    props: { displayName, groups: gs },
  }));
}

interface Props {
  displayName: string;
  groups: Group[];
}
const { displayName, groups } = Astro.props;
const slugs = groups.map((g) => g.baseSlug);
---

<PageLayout
  title={`Posts tagged ${displayName} — Yuhan Wang`}
  description={`All blog posts tagged with ${displayName}.`}
  active="blog"
  heading={displayName}
  intro={`${groups.length} ${groups.length === 1 ? 'essay' : 'essays'}`}
>
  <EssayFrames slugs={slugs} filter={false} />
  <p class="mt-12">
    <a href="/blog/" class="link-sweep inline-block py-2 font-display text-[13px] uppercase tracking-[0.1em] text-muted [--sweep-offset:4px] hover:text-ink">
      All essays
    </a>
  </p>
</PageLayout>
