---
// src/pages/blog/index.astro
// One list of essays with a filter: All, Personal, AI. The filter reads the URL hash
// (/blog/#ai), so links from a post's category label land on the right view.
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { CATEGORIES, CATEGORY_META, estimateReadingTime, groupByBaseSlug, parsePostId } from '../../lib/blog';

const all = await getCollection('blog', ({ data }) => !data.draft);
const groups = groupByBaseSlug(all);
const listed = [...groups.filter((g) => g.pinned), ...groups.filter((g) => !g.pinned)];

const filters = [
  { key: 'all', label: 'All', href: '/blog/', count: listed.length },
  ...CATEGORIES.map((category) => ({
    key: category,
    label: CATEGORY_META[category].label,
    href: `/blog/#${category}`,
    count: listed.filter((g) => g.primary.data.category === category).length,
  })),
];

const availableFor = (g: (typeof groups)[number]) => ({
  en: !!g.posts.en,
  zh: !!g.posts.zh,
});
---

<PageLayout
  title="Blog — Yuhan Wang"
  description="Essays by Yuhan Wang: personal writing, and thinking on AI."
  active="blog"
  heading="Blog"
  intro="Essays on AI, work, and where we belong."
  horizon
>
  <nav aria-label="Filter essays" class="rise mb-6 flex flex-wrap gap-x-8 gap-y-2 [--rise-delay:200ms]" data-essay-filter>
    {filters.map((filter) => (
      <a
        href={filter.href}
        data-filter={filter.key}
        aria-current={filter.key === 'all' ? 'true' : undefined}
        class="essay-filter link-sweep inline-flex items-baseline gap-2 py-2 font-display text-[15px] uppercase tracking-[0.1em] text-muted [--sweep-offset:4px] hover:text-ink"
      >
        {filter.label}
        <span class="font-mono text-[11px] tracking-normal">{filter.count}</span>
      </a>
    ))}
  </nav>

  {listed.length > 0 ? (
    <div class="essay-list border-b border-hairline" data-essay-rows>
      {listed.map((g) => (
        <PostCard
          post={g.primary}
          baseSlug={g.baseSlug}
          primaryLang={parsePostId(g.primary.id).lang}
          available={availableFor(g)}
          readingTime={estimateReadingTime(g.primary.body ?? '')}
          pinned={g.pinned}
        />
      ))}
    </div>
  ) : (
    <p class="text-muted">No posts yet. Check back soon.</p>
  )}
</PageLayout>

<style is:global>
  .essay-filter[aria-current='true'] {
    color: rgb(var(--ink));
    background-size: 100% 1px;
  }
</style>

<script>
  const KEYS = ['personal', 'ai'];

  function apply(key: string) {
    const nav = document.querySelector<HTMLElement>('[data-essay-filter]');
    const rows = document.querySelectorAll<HTMLElement>('[data-essay-rows] [data-category]');
    if (!nav) return;
    const active = KEYS.includes(key) ? key : 'all';
    nav.querySelectorAll<HTMLElement>('[data-filter]').forEach((link) => {
      if (link.dataset.filter === active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    rows.forEach((row) => {
      row.hidden = active !== 'all' && row.dataset.category !== active;
    });
  }

  function fromHash() {
    apply(location.hash.replace('#', ''));
  }

  // Same filter, but essays slide to their new places (View Transitions, where supported).
  function applyAnimated(key: string) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || typeof document.startViewTransition !== 'function') {
      apply(key);
      return;
    }
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-essay-rows] [data-category]'));
    rows.forEach((row, i) => {
      row.style.setProperty('view-transition-name', 'essay-row-' + i);
      row.style.setProperty('view-transition-class', 'essay-row');
    });
    const transition = document.startViewTransition(() => apply(key));
    transition.finished.finally(() => {
      rows.forEach((row) => {
        row.style.removeProperty('view-transition-name');
        row.style.removeProperty('view-transition-class');
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    const nav = document.querySelector<HTMLElement>('[data-essay-filter]');
    if (!nav) return;
    fromHash();
    // Filter in place: keep the router from treating these links as navigation.
    nav.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('[data-filter]');
      if (!link) return;
      event.preventDefault();
      history.replaceState(history.state, '', link.getAttribute('href') ?? '/blog/');
      applyAnimated(link.dataset.filter ?? 'all');
    });
  });
  window.addEventListener('hashchange', fromHash);
</script>
