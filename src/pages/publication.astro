---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import { publications } from '../data/publications';
---

<PageLayout
  title="Publication — Yuhan Wang"
  description="Selected research publication by Yuhan Wang."
  active="publication"
  eyebrow="Publication"
  heading="Research Papers"
  intro="Selected work in computer vision, embodied intelligence, and 4D perception."
>
  <section class="mt-16 max-w-[46rem]">
    <p class="label-smallcaps mb-2">Selected</p>
    <ul>
      {publications.map((publication) => (
        <li class="hairline grid grid-cols-1 gap-6 pb-2 pt-8 sm:grid-cols-[160px_1fr]">
          <div class="relative">
            <span class="absolute left-2 top-2 z-10 bg-accent px-2 py-0.5 font-mono text-xs text-bg">
              {publication.badge}
            </span>
            <Image
              src={publication.image}
              alt={publication.title}
              widths={[160, 320]}
              sizes="(max-width: 639px) 100vw, 160px"
              class="h-auto w-full rounded"
            />
          </div>
          <div>
            <a
              href={publication.href}
              class="font-serif font-semibold text-ink transition-colors hover:text-accent"
            >
              {publication.title}
            </a>
            <p class="mt-2 text-sm leading-relaxed text-muted" set:html={publication.authorsHtml} />
            <p class="mt-4 flex gap-5 text-sm">
              <a href={publication.href} class="label-smallcaps transition-colors hover:text-ink">Project</a>
              {publication.paperHref && (
                <a href={publication.paperHref} class="label-smallcaps transition-colors hover:text-ink">Paper</a>
              )}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</PageLayout>
