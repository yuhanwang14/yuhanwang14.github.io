---
// src/pages/publication.astro
// The paper plates, plus the page-wide pieces they use: loops that play only while on
// screen, and BibTeX buttons that copy the citation.
import PageLayout from '../layouts/PageLayout.astro';
import PublicationPlates from '../components/publication/PublicationPlates.astro';
import { site } from '../data/site';

const scholar = site.social.find((link) => link.label === 'Scholar');
---

<PageLayout
  title="Publication — Yuhan Wang"
  description="Research by Yuhan Wang in computer vision and 4D perception."
  active="publication"
  heading="Publication"
  intro="Research in computer vision, embodied intelligence, and 4D perception."
>
  {scholar && (
    <a
      slot="mast"
      href={scholar.href}
      target="_blank"
      rel="noopener noreferrer"
      class="link-sweep mt-5 inline-block py-1 font-display text-[13px] uppercase tracking-[0.12em] text-ink/75 [--sweep-offset:0px] hover:text-ink"
    >Google Scholar</a>
  )}
  <PublicationPlates />
</PageLayout>

<style is:global>
  .pub-link {
    display: inline-block;
    padding-block: 0.2rem;
    font-family: 'Metropolitan Line', Geist, system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink));
  }
  .pub-link:hover,
  .pub-link:focus-visible,
  .pub-link[data-copied] {
    color: rgb(var(--accent));
  }
  .pub-link[data-copied] {
    background-size: 100% 1px;
  }
  /* The loop is points on black: lighten lets the page colour show through its black, and
     the mask fades its cut edges. */
  .pub-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    isolation: isolate;
    background-color: rgb(var(--bg));
  }
  .pub-loop {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: lighten;
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
    mask-composite: intersect;
  }
  .pub-board {
    display: grid;
    place-items: center;
    background-color: rgb(var(--bg-alt));
  }
  .pub-board span {
    font-family: 'Metropolitan Line', Geist, system-ui, sans-serif;
    font-size: 1.5rem;
    color: rgb(var(--muted));
  }
  .pub-cap {
    margin-top: 0.8rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    line-height: 1.65;
    color: rgb(var(--muted));
    text-wrap: pretty;
  }
</style>

<script>
  let observer: IntersectionObserver | undefined;

  function initLoops() {
    observer?.disconnect();
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-play-in-view]'));
    if (!videos.length) return;
    // Reduced motion keeps the poster frame.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (video.preload !== 'auto') video.preload = 'auto';
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.35 },
    );
    videos.forEach((video) => observer?.observe(video));
  }

  function initBibtex() {
    document.querySelectorAll<HTMLButtonElement>('[data-bibtex]').forEach((button) => {
      const label = button.querySelector<HTMLElement>('[data-bib-label]');
      const status = button.closest('li')?.querySelector<HTMLElement>('[data-bib-status]');
      let timer: number | undefined;
      button.addEventListener('click', async () => {
        let ok = true;
        try {
          await navigator.clipboard.writeText(button.dataset.bibtex ?? '');
        } catch {
          ok = false;
        }
        if (!label) return;
        window.clearTimeout(timer);
        label.textContent = ok ? 'Copied' : 'Copy failed';
        if (ok) button.setAttribute('data-copied', '');
        if (status) status.textContent = ok ? 'BibTeX copied to clipboard.' : 'Could not copy BibTeX.';
        timer = window.setTimeout(() => {
          label.textContent = 'BibTeX';
          button.removeAttribute('data-copied');
        }, 1600);
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initLoops();
    initBibtex();
  });
  document.addEventListener('astro:before-swap', () => observer?.disconnect());
</script>
