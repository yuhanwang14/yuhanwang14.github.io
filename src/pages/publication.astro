---
// src/pages/publication.astro
// Each paper: text on the left, a muted loop of its own results on the right. The loop
// plays only while on screen; the BibTeX button copies the official citation.
import PageLayout from '../layouts/PageLayout.astro';
import { publications } from '../data/publications';
---

<PageLayout
  title="Publication — Yuhan Wang"
  description="Research by Yuhan Wang in computer vision and 4D perception."
  active="publication"
  heading="Publication"
  intro="Research in computer vision, embodied intelligence, and 4D perception."
  horizon
>
  <ol class="border-b border-hairline">
    {publications.map((publication, i) => (
      <li class="border-t border-hairline py-12 md:py-16">
        <article class="grid grid-cols-1 gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] md:items-center md:gap-14">
          <div class="min-w-0" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <p class="label-smallcaps text-accent">{publication.badge}</p>
            <h2 class="mt-4 font-display text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.12] text-ink">
              <a href={publication.href} class="transition-colors duration-200 hover:text-accent focus-visible:text-accent">
                {publication.title}
              </a>
            </h2>
            <p
              class="mt-5 max-w-[36rem] text-[1.0625rem] leading-relaxed text-muted [&_strong]:font-semibold [&_strong]:text-ink"
              set:html={publication.authorsHtml}
            />
            <p class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-2">
              <a href={publication.href} class="link-sweep inline-block py-2 font-display text-[15px] uppercase tracking-[0.1em] text-ink [--sweep-offset:4px] hover:text-accent">
                Project
              </a>
              {publication.paperHref && (
                <a href={publication.paperHref} class="link-sweep inline-block py-2 font-display text-[15px] uppercase tracking-[0.1em] text-ink [--sweep-offset:4px] hover:text-accent">
                  Paper
                </a>
              )}
              {publication.bibtex && (
                <button
                  type="button"
                  class="bib-copy link-sweep inline-block py-2 font-display text-[15px] uppercase tracking-[0.1em] text-ink [--sweep-offset:4px] hover:text-accent"
                  data-bibtex={publication.bibtex}
                >
                  <span data-bib-label>BibTeX</span>
                </button>
              )}
            </p>
            <p class="sr-only" aria-live="polite" data-bib-status></p>
          </div>
          <a
            href={publication.href}
            tabindex="-1"
            aria-hidden="true"
            class="group block overflow-hidden rounded-[2px]"
            data-reveal
            style={`--reveal-delay:${i * 90 + 140}ms`}
          >
            <video
              class="pub-loop block h-auto w-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
              src={publication.media.video}
              poster={publication.media.poster}
              width={publication.media.width}
              height={publication.media.height}
              muted
              loop
              playsinline
              preload="none"
              disablepictureinpicture
              data-play-in-view
            ></video>
          </a>
        </article>
      </li>
    ))}
  </ol>
</PageLayout>

<style is:global>
  /* The loop is points on black; lighten lets it sit directly on any dark background.
     The crop cuts through the point cloud, so its edges fade out instead of ending hard. */
  .pub-loop {
    mix-blend-mode: lighten;
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
    mask-composite: intersect;
  }
  .bib-copy {
    transition: transform 160ms ease-out, color 200ms ease-out, background-size 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bib-copy:active {
    transform: scale(0.97);
  }
  .bib-copy[data-copied] {
    color: rgb(var(--accent));
    background-size: 100% 1px;
  }
</style>

<script>
  let observer: IntersectionObserver | undefined;

  function initLoops() {
    observer?.disconnect();
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-play-in-view]'));
    if (!videos.length) return;
    // Reduced motion keeps the poster frame.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (video.preload !== 'auto') video.preload = 'auto';
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.35 },
    );
    videos.forEach((video) => observer?.observe(video));
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  function initBibtex() {
    document.querySelectorAll<HTMLButtonElement>('[data-bibtex]').forEach((button) => {
      const label = button.querySelector<HTMLElement>('[data-bib-label]');
      const status = button.closest('div')?.querySelector<HTMLElement>('[data-bib-status]');
      let timer: number | undefined;
      button.addEventListener('click', async () => {
        const ok = await copyText(button.dataset.bibtex ?? '');
        if (!label) return;
        window.clearTimeout(timer);
        label.textContent = ok ? 'Copied' : 'Copy failed';
        if (ok) button.setAttribute('data-copied', '');
        if (status) status.textContent = ok ? 'BibTeX copied to clipboard.' : 'Could not copy BibTeX.';
        timer = window.setTimeout(() => {
          label.textContent = 'BibTeX';
          button.removeAttribute('data-copied');
        }, 1600);
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initLoops();
    initBibtex();
  });
  document.addEventListener('astro:before-swap', () => observer?.disconnect());
</script>
