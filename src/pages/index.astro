---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/shared/Footer.astro';
import FogWindow from '../components/home/FogWindow.astro';
import { site } from '../data/site';

const links = [
  { label: 'Publication', href: '/publication/' },
  { label: 'Blog', href: '/blog/' },
];
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.description}>
  <main class="mx-auto max-w-[1100px] px-6 pt-16 md:pt-24">
    <header class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="rise font-display text-[clamp(3rem,8.5vw,6rem)] font-normal leading-[0.95] tracking-[-0.01em] text-ink">
          {site.name}<span class="text-accent">.</span>
        </h1>
        <p class="rise mt-5 font-display text-[clamp(1.375rem,2.8vw,2rem)] leading-tight text-muted [--rise-delay:120ms]">
          Founder | Engineer | Exile
        </p>
      </div>
      <nav aria-label="Primary" class="rise -mb-3 flex gap-7 [--rise-delay:240ms]">
        {links.map((link) => (
          <a
            href={link.href}
            class="link-sweep inline-block py-3 font-display text-[15px] uppercase tracking-[0.1em] text-muted [--sweep-offset:10px] hover:text-ink focus-visible:text-ink"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <FogWindow class="rise mt-12 md:mt-16 [--rise-delay:360ms]" />
  </main>

  <Footer />
</BaseLayout>

