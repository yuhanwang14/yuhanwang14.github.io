---
// src/pages/index.astro
// The homepage is one screen: an aerial LiDAR point cloud of London or Boston behind the
// name. The city switch in the corner swaps between them and shows local time.
import BaseLayout from '../layouts/BaseLayout.astro';
import CityCloud from '../components/home/CityCloud.astro';
import { cities } from '../data/cities';
import { site } from '../data/site';

const links = [
  { label: 'Publication', href: '/publication/' },
  { label: 'Blog', href: '/blog/' },
];
const social = ['LinkedIn', 'GitHub']
  .map((label) => site.social.find((link) => link.label === label))
  .filter((link): link is NonNullable<typeof link> => Boolean(link));
const email = site.emails[0]?.address;
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.description}>
  <main class="home-hero relative h-[100svh] min-h-[540px] overflow-hidden text-[#F1EEE7]">
    <CityCloud class="absolute inset-0" />
    <div class="home-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex h-full max-w-[1280px] flex-col justify-between px-6 py-6 md:px-10 md:py-8">
      <header class="flex items-start justify-between gap-6">
        <div role="group" aria-label="City" class="rise flex gap-7 [--rise-delay:500ms]" data-city-switch>
          {cities.map((city, i) => (
            <button
              type="button"
              data-city={city.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="city-btn text-left"
            >
              <span class="block font-mono text-[11px] uppercase tracking-[0.14em]">{city.label}</span>
              <span class="mt-1 block font-display text-[22px] leading-none tabular-nums" data-clock={city.timeZone}>--:--</span>
            </button>
          ))}
        </div>
        <nav aria-label="Primary" class="rise flex gap-7 [--rise-delay:240ms]">
          {links.map((link) => (
            <a
              href={link.href}
              class="link-sweep inline-block py-1 font-display text-[14px] uppercase tracking-[0.12em] text-[#F1EEE7]/85 [--sweep-offset:0px] hover:text-white focus-visible:text-white"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </header>

      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <h1 class="rise font-display text-[clamp(3.25rem,9vw,7rem)] font-normal leading-[0.92] tracking-[-0.01em]">
            {site.name}<span class="text-[#FF5A1F]">.</span>
          </h1>
          <p class="rise mt-4 font-display text-[clamp(1.25rem,2.6vw,1.9rem)] leading-tight text-[#F1EEE7]/80 [--rise-delay:120ms]">
            Founder | Engineer | Exile
          </p>
        </div>
        <ul class="rise flex flex-wrap items-baseline gap-x-6 gap-y-2 [--rise-delay:360ms]">
          {social.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="link-sweep inline-block py-1 font-display text-[13px] uppercase tracking-[0.12em] text-[#F1EEE7]/75 [--sweep-offset:0px] hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))}
          {email && <li class="select-all font-mono text-[13px] text-[#F1EEE7]/75">{email}</li>}
        </ul>
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  html:has(.home-hero),
  html:has(.home-hero) body {
    background: #0b0d10;
  }
  .home-scrim {
    background:
      linear-gradient(to top, rgb(11 13 16 / 0.82), rgb(11 13 16 / 0) 42%),
      linear-gradient(to right, rgb(11 13 16 / 0.5), rgb(11 13 16 / 0) 45%),
      linear-gradient(to bottom, rgb(11 13 16 / 0.6), rgb(11 13 16 / 0) 22%);
  }
  .city-btn {
    color: rgb(241 238 231 / 0.42);
    transition: color 300ms ease-out;
  }
  .city-btn:hover,
  .city-btn:focus-visible {
    color: rgb(241 238 231 / 0.8);
  }
  .city-btn[aria-pressed='true'] {
    color: #f1eee7;
  }
  .city-btn[aria-pressed='true'] [data-clock]::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 8px;
    vertical-align: 0.3em;
    border-radius: 50%;
    background: #ff5a1f;
  }
  .home-hero ::selection {
    background: rgb(255 90 31 / 0.35);
    color: #fff;
  }
</style>
