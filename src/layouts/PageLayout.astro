---
// src/layouts/PageLayout.astro
// Inner pages share one masthead. The homepage city, the one you last looked at, runs as a
// skyline across the top of the page, rising and scanned the way the homepage does. The page
// title sits small in the lower left corner of the skyline.
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import CityCloud from '../components/home/CityCloud.astro';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'research' | 'industry' | 'skills' | 'publication' | 'projects' | 'blog';
  heading?: string;
  intro?: string;
}
const { title, description, active = 'home', heading, intro } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="page-band" aria-hidden="true">
    <CityCloud mode="band" class="absolute inset-0" />
  </div>
  <Navbar active={active} />
  <main class:list={['relative z-[1] mx-auto max-w-[1280px] px-6 md:px-10', !heading && 'pt-16 md:pt-24']}>
    {heading && (
      <header class="mast">
        <div class="mast-text">
          <h1 class="mast-title">{heading}<span class="mast-stop text-accent">.</span></h1>
          {intro && <p class="mast-intro">{intro}</p>}
          <slot name="mast" />
        </div>
      </header>
    )}
    <slot />
  </main>
  <Footer />
</BaseLayout>
