---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import SEO from '../components/shared/SEO.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  jsonLd?: Record<string, unknown>;
  htmlLang?: string;
}
const { htmlLang = 'en', ...seoProps } = Astro.props;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Marks JS as available so scroll reveals can start hidden; re-applied after
         client-side navigation because the router swaps the <html> attributes.
         Elements that morph between pages skip their entrance after a client-side swap,
         so the morph lands on a visible element. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', function () {
        document.documentElement.classList.add('js');
        document.querySelectorAll('[data-still-on-swap]').forEach(function (el) {
          el.classList.remove('rise');
        });
      });
    </script>
    <link rel="preload" href="/fonts/MetropolitanLine-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Yuhan Wang — Blog" href="/rss.xml" />
    <SEO {...seoProps} />
    <!-- View Transitions: smooth EN ↔ ZH switch and inter-page navigation. -->
    <ClientRouter fallback="animate" />
  </head>
  <body class="min-h-screen fade-in-on-load">
    <slot />
    <script>
      // Scroll reveal: marked blocks and essay images rise into place as they enter the view.
      let observer: IntersectionObserver | undefined;

      function initReveal() {
        observer?.disconnect();
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal], .prose-academic img');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer?.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => observer?.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
