---
// src/components/blog/PostCard.astro
// One essay in a listing: a full-width row of type. Meta on the left, title and
// description on the right. data-category lets the Blog page filter rows.
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_META, LANG_LABELS, formatDate, type Lang } from '../../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  baseSlug: string;
  primaryLang: Lang;
  /** Languages this post group has versions for. */
  available: Partial<Record<Lang, boolean>>;
  readingTime: number;
  pinned?: boolean;
}
const { post, baseSlug, primaryLang, available, readingTime, pinned = false } = Astro.props;
const { title, description, publishedAt, tags, category } = post.data;
const href = primaryLang === 'zh' ? `/blog/${baseSlug}/zh/` : `/blog/${baseSlug}/`;
const langs = (Object.keys(available) as Lang[]).filter((l) => available[l]);
---

<article class="essay-row border-t border-hairline" data-category={category}>
  <a href={href} class="group grid grid-cols-1 gap-x-10 gap-y-3 py-10 md:grid-cols-[10rem_minmax(0,1fr)] md:py-12">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-[0.08em] text-muted md:flex-col md:gap-y-2 md:pt-3">
      <span class="font-display text-[13px] tracking-[0.1em] text-accent">{CATEGORY_META[category].label}</span>
      <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
      <span>{readingTime} min read</span>
      {langs.length > 1 && <span>{langs.map((l) => LANG_LABELS[l]).join(' · ')}</span>}
      {pinned && <span class="text-accent">Pinned</span>}
    </div>
    <div class="min-w-0">
      <h2 class="font-display text-[clamp(1.75rem,3.4vw,2.6rem)] font-normal leading-[1.1] text-ink [text-wrap:balance] transition-colors duration-200 group-focus-visible:text-accent">
        {title}
      </h2>
      <p class="mt-4 max-w-[38rem] text-[1.0625rem] leading-relaxed text-muted [text-wrap:pretty]">{description}</p>
      {tags.length > 0 && <p class="label-smallcaps mt-5">{tags.join(' · ')}</p>}
    </div>
  </a>
</article>
