---
// src/components/shared/ProfileCard.astro
// Used as the left sidebar by PageLayout. Compact, stacks vertically.
import { Image } from 'astro:assets';
import yuhanPhoto from '../../assets/images/yuhan.png';
import { site } from '../../data/site';
---

<aside class="text-sm">
  <Image
    src={yuhanPhoto}
    alt={`Photo of ${site.name}`}
    width={140}
    height={140}
    class="rounded-full border border-hairline w-32 h-32 md:w-36 md:h-36 object-cover mb-4"
  />
  <p class="font-serif font-semibold text-ink text-lg leading-tight">{site.name}</p>
  <p class="text-muted leading-relaxed mt-1">{site.role}</p>
  <p class="font-mono text-xs text-muted mt-3">{site.location}</p>

  <ul class="font-mono text-xs text-muted mt-4 space-y-1.5">
    {site.emails.map((e) => (
      <li class="break-all">
        <a
          href={`mailto:${e.address}`}
          class="hover:text-ink transition-colors duration-200"
          title={`${e.label} email`}
        >
          {e.address}
        </a>
      </li>
    ))}
  </ul>

  <ul class="flex flex-col gap-1 mt-5">
    {site.social.filter((s) => s.label !== 'RSS').map((s) => (
      <li>
        <a
          href={s.href}
          class="label-smallcaps hover:text-ink transition-colors duration-200"
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          {s.label}
        </a>
      </li>
    ))}
  </ul>
</aside>
