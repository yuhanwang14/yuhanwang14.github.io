---
import { Image } from 'astro:assets';
import yuhanPhoto from '../../assets/images/yuhan.png';
import { site } from '../../data/site';
---

<aside class="text-sm">
  <Image
    src={yuhanPhoto}
    alt={`Photo of ${site.name}`}
    width={140}
    height={140}
    class="rounded-full border border-hairline w-32 h-32 md:w-36 md:h-36 object-cover mb-4"
  />
  <p class="font-serif font-semibold text-ink text-lg leading-tight">{site.name}</p>
  <p class="text-muted leading-relaxed mt-1">{site.role}</p>
  <p class="font-mono text-xs text-muted mt-3">{site.location}</p>

  <ul class="font-mono text-xs text-muted mt-4 space-y-1.5">
    {site.emails.map((email) => (
      <li class="break-all">{email.address}</li>
    ))}
  </ul>

  <ul class="flex flex-col gap-1 mt-5">
    {site.social.filter((link) => link.label !== 'RSS').map((link) => (
      <li>
        <a
          href={link.href}
          class="label-smallcaps hover:text-ink transition-colors duration-200"
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          {link.label === 'Scholar' ? 'Google Scholar' : link.label}
        </a>
      </li>
    ))}
  </ul>
</aside>
