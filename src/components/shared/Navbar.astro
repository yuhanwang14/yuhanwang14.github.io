---
// src/components/shared/Navbar.astro
import { site } from '../../data/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  active?: 'home' | 'research' | 'industry' | 'skills' | 'publication' | 'blog';
}
const { active = 'home' } = Astro.props;

const links: { label: string; href: string; key: NonNullable<Props['active']> }[] = [
  { label: 'Publication', href: '/publication/', key: 'publication' },
  { label: 'Blog', href: '/blog/', key: 'blog' },
];
---

<nav class="border-b border-hairline" aria-label="Primary">
  <div class="max-w-[1100px] mx-auto px-6 flex items-center justify-between h-14">
    <a
      href="/"
      aria-current={active === 'home' ? 'page' : undefined}
      class:list={[
        'font-serif font-semibold text-ink hover:text-accent transition-colors duration-200',
        active === 'home' && 'text-accent',
      ]}
    >
      {site.name}
    </a>
    <div class="flex items-center gap-4 sm:gap-6">
      <ul class="flex items-center">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.key === active ? 'page' : undefined}
              class:list={[
                'label-smallcaps inline-flex min-h-11 items-center px-2 transition-colors duration-200',
                link.key === active
                  ? 'text-accent'
                  : 'hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </div>
</nav>
