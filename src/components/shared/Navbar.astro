---
// src/components/shared/Navbar.astro
import { Image } from 'astro:assets';
import yuhanPhoto from '../../assets/images/yuhan.jpg';
import { site } from '../../data/site';

interface Props {
  active?: 'home' | 'research' | 'industry' | 'skills' | 'publication' | 'projects' | 'blog';
}
const { active = 'home' } = Astro.props;

const links: { label: string; href: string; key: NonNullable<Props['active']> }[] = [
  { label: 'Publication', href: '/publication/', key: 'publication' },
  { label: 'Projects', href: '/projects/', key: 'projects' },
  { label: 'Blog', href: '/blog/', key: 'blog' },
];
---

<nav aria-label="Primary" class="relative z-10 mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-6 pt-6 md:px-10 md:pt-8">
  <a href="/" aria-label={site.name} class="group inline-flex items-center gap-3 font-display text-xl leading-none text-ink">
    <Image
      src={yuhanPhoto}
      alt=""
      widths={[36, 72]}
      sizes="36px"
      class="h-9 w-9 rounded-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110"
    />
    <span
      class="inline-block leading-[0.92] tracking-[-0.01em] transition-colors duration-200 group-hover:text-accent max-[479px]:hidden"
      transition:name="site-name"
      transition:animate="initial"
    >{site.name}<span class="text-accent">.</span></span>
  </a>
  <ul class="flex items-center gap-5 sm:gap-6">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-current={link.key === active ? 'page' : undefined}
          class:list={[
            'link-sweep inline-block py-3 font-display text-[14px] uppercase tracking-[0.12em] [--sweep-offset:10px]',
            link.key === active ? 'text-accent' : 'text-muted hover:text-ink focus-visible:text-ink',
          ]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
